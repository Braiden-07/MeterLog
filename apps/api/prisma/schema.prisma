// Datasource points at the MIGRATION role: this schema file is consumed by the
// Prisma CLI, which only ever runs migrations. The runtime client is constructed
// explicitly against DATABASE_URL (the restricted app role) in src/prisma —
// keeping the two roles impossible to confuse. See ADR-004.
datasource db {
  provider = "postgresql"
  url      = env("MIGRATION_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// NOTE: Prisma models the tables, never the RLS policies, grants, or roles that
// protect them (ADR-002). Those live only in hand-written migration SQL, and
// `prisma migrate dev` will happily generate a migration that omits them — which
// is why test/db/catalog-rls.spec.ts asserts coverage rather than trusting it.

enum MembershipRole {
  admin
  technician
  auditor

  @@map("membership_role")
}

enum AssetStatus {
  installed
  active
  maintenance
  decommissioned

  @@map("asset_status")
}

enum AssetEventType {
  created
  installed
  activated
  maintenance_started
  maintenance_completed
  decommissioned

  @@map("asset_event_type")
}

/// The audit action vocabulary (ADR-012). Fourteen values over the ELEVEN named
/// mutation types; `user.created`, `asset_event.created` and the
/// `membership.updated` total-function fallback are the three extras. Prisma
/// cannot express a dotted enum member name, so each is `@map`ped.
enum AuditAction {
  user_created            @map("user.created")
  membership_created      @map("membership.created")
  membership_role_changed @map("membership.role_changed")
  membership_revoked      @map("membership.revoked")
  membership_updated      @map("membership.updated")
  asset_created           @map("asset.created")
  asset_updated           @map("asset.updated")
  asset_status_changed    @map("asset.status_changed")
  asset_decommissioned    @map("asset.decommissioned")
  asset_event_created     @map("asset_event.created")
  reading_created         @map("reading.created")
  maintenance_created     @map("maintenance.created")
  maintenance_updated     @map("maintenance.updated")
  maintenance_deleted     @map("maintenance.deleted")

  @@map("audit_action")
}

model Tenant {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  memberships Membership[]
  assets      Asset[]
  assetEvents AssetEvent[]
  readings    Reading[]
  maintenance MaintenanceRecord[]

  @@map("tenants")
}

/// Pure identity — no tenant_id, no role (ADR-006 §2). Both live on Membership.
model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @db.Citext
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  memberships Membership[]
  assetEvents AssetEvent[]
  readings    Reading[]
  maintenance MaintenanceRecord[]
  auditRows   AuditLog[]

  @@map("users")
}

/// Grants one user one role in one tenant. A user may hold many.
model Membership {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?      @map("deleted_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId], map: "memberships_tenant_id_idx")
  @@map("memberships")
}

/// First domain table (step 6). Mutable, soft-deleted.
///
/// `serial_number` is UNIQUE PER TENANT AMONG LIVE ROWS, enforced by
/// `assets_tenant_serial_live_key` — a PARTIAL unique index that lives only in
/// migration SQL. Prisma cannot express a `WHERE` clause on an index, so it is
/// absent here exactly as `memberships_user_tenant_live_key` is absent from the
/// Membership model. Do not "restore" it as a plain `@@unique`: that would make
/// a decommissioned serial permanently unusable.
model Asset {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  serialNumber String      @map("serial_number")
  type         String
  status       AssetStatus @default(installed)
  location     String?
  installedAt  DateTime?   @map("installed_at") @db.Timestamptz(6)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz(6)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  events      AssetEvent[]
  readings    Reading[]
  maintenance MaintenanceRecord[]

  /// The parent half of every child's composite FK (ADR-007). `id` is already
  /// unique alone; this exists solely so a child can reference (id, tenant_id).
  @@unique([id, tenantId], map: "assets_id_tenant_key")
  @@index([tenantId], map: "assets_tenant_id_idx")
  @@map("assets")
}

/// APPEND-ONLY (declared in CLAUDE.md, mirrored by APPEND_ONLY_TABLES). No
/// updated_at, no deleted_at, and the app role holds only SELECT, INSERT.
model AssetEvent {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  assetId   String         @map("asset_id") @db.Uuid
  eventType AssetEventType @map("event_type")
  payload   Json           @default("{}")
  createdBy String         @map("created_by") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  author User   @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  /// ADR-007 composite FK: a child row whose tenant disagrees with its asset is
  /// unrepresentable. Rejected as 23503, distinct from the RLS 42501.
  asset Asset @relation(fields: [assetId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "asset_events_asset_tenant_fkey")

  @@index([tenantId], map: "asset_events_tenant_id_idx")
  @@index([assetId, createdAt], map: "asset_events_asset_id_created_at_idx")
  @@map("asset_events")
}

/// APPEND-ONLY, and the dangerous kind: PROJECT_BRIEF never SAYS so (:138) — the
/// property follows only from :146 plus the absence of updated_at/deleted_at. Its
/// authority is the declaration in CLAUDE.md, mirrored by APPEND_ONLY_TABLES and
/// bound to the grant by catalog assertion 13. Do NOT add updated_at.
///
/// A LEAF: no `@@unique([id, tenantId])`. That composite exists on Asset only as
/// the parent half of a child's FK, and nothing is a child of a reading.
model Reading {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  assetId   String   @map("asset_id") @db.Uuid
  value     Decimal  @db.Decimal
  unit      String
  /// Domain time — when the reading was taken. Caller-supplied, no default.
  readAt    DateTime @map("read_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid
  /// Server time — when the row was inserted. Deliberately distinct from readAt.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  author User   @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  /// ADR-007 composite FK, second child. A reading whose tenant disagrees with its
  /// asset is unrepresentable. Rejected as 23503, distinct from the RLS 42501.
  asset Asset @relation(fields: [assetId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "readings_asset_tenant_fkey")

  @@index([tenantId], map: "readings_tenant_id_idx")
  @@index([assetId, readAt], map: "readings_asset_id_read_at_idx")
  @@map("readings")
}

/// The fourth and final v1.0 domain child, and the only MUTABLE one: UPDATE here
/// means "edit a field", not "advance a state machine" (ADR-008).
///
/// SOFT DELETE ONLY for v1.0 — the app role holds SELECT, INSERT, UPDATE and no
/// DELETE, asserted as an equality by catalog assertion 14. Hard delete is
/// deferred until after the audit module (OPEN-9) so no destructive operation
/// predates the trail that would make it accountable.
///
/// A LEAF: no `@@unique([id, tenantId])` — nothing is a child of a maintenance
/// record.
model MaintenanceRecord {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  assetId     String    @map("asset_id") @db.Uuid
  description String
  /// Domain time — when the work was performed. Caller-supplied, no default.
  performedAt DateTime  @map("performed_at") @db.Timestamptz(6)
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  /// Soft delete (ADR-008). Appears in NO policy predicate — OPEN-5.
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  author User   @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  /// ADR-007 composite FK, third child. Rejected as 23503, not the RLS 42501.
  asset Asset @relation(fields: [assetId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "maintenance_records_asset_tenant_fkey")

  @@index([tenantId], map: "maintenance_records_tenant_id_idx")
  @@index([assetId, performedAt, id], map: "maintenance_records_asset_id_performed_at_idx")
  @@map("maintenance_records")
}

/// APPEND-ONLY, and the strongest instance of that property in the schema: the
/// other two are written by the app role and merely never updated, while this one
/// THE APP ROLE CANNOT WRITE AT ALL. It holds `SELECT` and nothing else; the
/// `audit_capture` SECURITY DEFINER trigger is the only writer (ADR-009/ADR-010).
///
/// NOT MODELLED HERE, and both absences are load-bearing rather than oversights —
/// Prisma models tables and never triggers, policies, or grants (ADR-002):
///   * the six `*_audit` triggers and the `audit_capture` function;
///   * the per-table redaction allowlist each trigger carries (ADR-011).
/// All of it lives in migration SQL, and `catalog-rls.spec.ts` asserts it rather
/// than trusting it — assertions 16 and 17 in particular.
///
/// NO RELATION TO Tenant, deliberately: the migration gives `tenant_id` no foreign
/// key, because a RESTRICT FK would let the audit trail BLOCK a future tenant
/// deletion, and an audit trail must never veto the operation it is recording.
model AuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// NULLABLE. Taken from the mutated row where it has a tenant_id; from
  /// app.current_tenant where it does not (`users` — ADR-006 §2). NULL for the
  /// pre-auth bootstrap, which reaches neither. No FK — see the note above.
  tenantId String? @map("tenant_id") @db.Uuid

  /// NULLABLE (ADR-009). `register_tenant` runs pre-authentication, so there is
  /// no actor BY CONSTRUCTION. NULL actor + NULL role + NULL tenant all mean one
  /// thing: a system / pre-authentication action, reachable only via bootstrap.
  actorUserId String? @map("actor_user_id") @db.Uuid

  /// ROLE AT THE TIME OF THE ACTION (OPEN-4), looked up by the trigger while the
  /// mutation is in flight. A DENORMALIZED SNAPSHOT — do NOT "normalize" it away
  /// by joining to Membership at read time: the role may have changed or the
  /// membership been revoked, which is exactly the point of storing it.
  actorRole MembershipRole? @map("actor_role")

  /// PROJECT_BRIEF §5 calls these entity_type / entity_id. Renamed because the
  /// trail is keyed by TABLE and ROW, which is what a trigger knows (ADR-011).
  tableName String @map("table_name")
  rowId     String @map("row_id") @db.Uuid

  action AuditAction

  /// `{ before, after }` in one column rather than the brief's two, so the
  /// redaction filter and the changed-column diff cannot drift apart (ADR-011).
  payload Json

  /// Append-only: created_at only (PROJECT_BRIEF §5 :146).
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt, id], map: "audit_log_tenant_id_created_at_idx")
  @@index([tableName, rowId], map: "audit_log_table_name_row_id_idx")
  @@map("audit_log")
}
